# Backend API (required). Use your dev tunnel or staging URL.
EXPO_PUBLIC_API_URL=https://your-ngrok-subdomain.ngrok-free.app/api/v1

# Ola Maps credentials are NOT used in the vendor app.
# Configure OLA_MAPS_API_KEY or OLA_MAPS_CLIENT_ID + OLA_MAPS_CLIENT_SECRET on the backend.
# Maps load via GET /maps/sdk-config (OAuth Bearer or api_key on tile requests).
