{
  "expo": {
    "name": "Deccoryy Partner",
    "slug": "decoryy-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deccoryy-partner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Decoryy uses your location when you are en route to a booking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Decoryy shares your location in the background while you are en route so customers can track the trip.",
        "UIBackgroundModes": ["location"],
        "NSUserNotificationsUsageDescription": "Decoryy sends alerts when new bookings are assigned to you.",
        "NSCameraUsageDescription": "Decoryy uses the camera to send photos in booking chat.",
        "NSPhotoLibraryUsageDescription": "Decoryy uses your photo library to send images in booking chat."
      }
    },
    "android": {
      "package": "com.deccoryy.partner",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Decoryy uses your location when you are en route to a booking.",
          "locationAlwaysAndWhenInUsePermission": "Decoryy shares your location in the background while you are en route so customers can track the trip.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to photos to send images in chat.",
          "cameraPermission": "Allow camera access to take photos for chat."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2bdebd42-ee5c-4225-9f21-9603059dd720"
      },
      "router": {}
    },
    "owner": "expo1212"
  }
}
