# Copy to `.env` and fill in values. Never commit `.env`.

# Backend API base (include `/api/v1`), e.g. ngrok tunnel while developing.
EXPO_PUBLIC_API_URL=https://your-tunnel.example.com/api/v1

# Public customer site (product share links: {WEB_URL}/p/{productId})
EXPO_PUBLIC_WEB_URL=https://www.deccorbuddys.com

# Google OAuth **Web** client ID — used in JS:
#   GoogleSignin.configure({ webClientId: EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID })
# Backend GOOGLE_CLIENT_ID must be the same Web client ID (token `aud` verification).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Google OAuth **Android** client ID — documentation only.
# Do NOT pass this to GoogleSignin.configure(). Android is satisfied by GCP
# (package name + SHA-1) and the native module after `expo run:android`.
EXPO_PUBLIC_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
