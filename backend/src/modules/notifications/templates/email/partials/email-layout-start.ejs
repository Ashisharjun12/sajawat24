<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title><%= pageTitle %></title>
  </head>
  <body style="margin:0;padding:0;background:<%= theme.bg %>;font-family:<%= theme.font %>;-webkit-font-smoothing:antialiased;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:<%= theme.bg %>;padding:32px 16px 40px;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:<%= theme.card %>;border-radius:<%= theme.cardRadius %>;overflow:hidden;border:1px solid <%= theme.border %>;">
            <tr>
              <td style="height:4px;background:<%= theme.primary %>;font-size:0;line-height:0;">&nbsp;</td>
            </tr>
            <tr>
              <td align="center" style="padding:28px 24px 16px;background:<%= theme.card %>;">
                <img
                  src="<%= theme.logoUrl %>"
                  alt="<%= theme.brandName %>"
                  width="48"
                  height="48"
                  style="display:block;width:48px;height:48px;border:0;border-radius:12px;"
                />
                <% if (typeof badge === 'string' && badge) { %>
                <p style="margin:12px 0 0;font-size:11px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:<%= theme.primary %>;"><%= badge %></p>
                <% } %>
                <h1 style="margin:10px 0 0;font-size:22px;line-height:1.3;font-weight:700;color:<%= theme.text %>;letter-spacing:-0.02em;"><%= headline %></h1>
              </td>
            </tr>
