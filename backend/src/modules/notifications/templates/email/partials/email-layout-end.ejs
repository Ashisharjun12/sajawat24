            <tr>
              <td align="center" style="padding:8px 28px 32px;">
                <a
                  href="<%= viewUrl %>"
                  style="display:inline-block;background:<%= theme.primary %>;color:<%= theme.primaryFg %>;text-decoration:none;font-size:15px;font-weight:600;padding:14px 32px;border-radius:999px;border:1px solid <%= theme.primary %>;"
                ><%= ctaLabel %></a>
              </td>
            </tr>
          </table>
          <p style="margin:18px 0 0;font-size:11px;line-height:1.5;color:<%= theme.textMuted %>;">
            <%= theme.brandName %> · <%= theme.footerTagline %>
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
