            <tr>
              <td align="center" style="padding:4px 24px 28px;">
                <a
                  href="<%= viewUrl %>"
                  style="display:inline-block;background:<%= theme.primary %>;color:<%= theme.primaryFg %>;text-decoration:none;font-size:15px;font-weight:600;padding:12px 28px;border-radius:<%= theme.btnRadius %>;border:1px solid <%= theme.primaryDark %>;"
                ><%= ctaLabel %></a>
              </td>
            </tr>
          </table>
          <p style="margin:16px 0 0;font-size:12px;line-height:1.5;color:<%= theme.textMuted %>;text-align:center;">
            <%= theme.brandName %> · <%= theme.footerTagline %>
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
