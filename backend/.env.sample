# Copy to backend/.env (local) or backend/.env on VPS: cp .env.sample .env
# Local: docker compose up -d · npm run dev · npm run worker:dev
# Docs: DEPLOY.md · docs/sms.md · docs/message-service.md

# =============================================================================
# Server
# =============================================================================
PORT=3000
NODE_ENV=development

# =============================================================================
# Postgres (Supabase pooler URL in production)
# =============================================================================
AI_ENABLED=false
POSTGRES_DATABASE_URL=

# =============================================================================
# Redis / Valkey (docker compose at repo root)
# =============================================================================
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6380/0
REDIS_CACHE_DB=1
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=120

# =============================================================================
# Worker
# =============================================================================
NOTIFICATION_WORKER_EXTERNAL=true

# =============================================================================
# Public URLs
# =============================================================================
API_PUBLIC_URL=http://localhost:3000
WEB_APP_ORIGIN=http://localhost:5174
# Production (comma-separated for CORS — first URL used in SMS/payment links):
# WEB_APP_ORIGIN=https://decorbuddys.com,https://www.decorbuddys.com
ADMIN_APP_ORIGIN=http://localhost:5173
EXPO_PUBLIC_ORIGIN=

# =============================================================================
# Auth & admin
# =============================================================================
JWT_SECRET=
OTP_PEPPER=
ADMIN_EMAIL=admin@decory.local
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=

# =============================================================================
# Realtime
# =============================================================================
REALTIME_PROVIDER=socketio
SOCKET_PATH=/socket.io
SOCKET_IO_REDIS=false

# =============================================================================
# Payments
# =============================================================================
PAYMENT_PROVIDER=razorpay
RAZORPAY_COD_COLLECTION_MODE=payment_link
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_KEY_ID=
CASHFREE_KEY_SECRET=
# PG webhooks use HMAC with CASHFREE_KEY_SECRET (no separate dashboard secret). Optional: previous/alt secret during key rotation only.
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
# COD at doorstep: pod_qr (Create Order + podQrCode) or payment_link only. Requires Cashfree S2S for pod_qr.
CASHFREE_COD_COLLECTION_MODE=pod_qr
# POD / link QR session TTL shown to vendor (minutes).
CASHFREE_COD_QR_TTL_MINUTES=60
# Cashfree dashboard webhook (sandbox/production): {API_PUBLIC_URL}/api/v1/webhooks/cashfree
# Enable payment link + order/payment events. For local dev, ngrok (or similar) must reach the API when testing COD QR pay.

# =============================================================================
# SMS — MSG91 + India DLT (worker queue; see docs/sms.md)
# =============================================================================
# dev = log only (local). msg91 = production India SMS.
SMS_PROVIDER=dev

MSG91_AUTH_KEY=
# 6-character DLT sender header (not the full brand name)
MSG91_SENDER_ID=
MSG91_ROUTE=4
MSG91_DLT_ENTITY_ID=

# Vendor Android SMS autofill hash (Play App Signing)
ANDROID_OTP_APP_HASH=

# DLT template IDs from MSG91 (enable SMS channel in admin after approval)
MSG91_TEMPLATE_LOGIN_OTP=
MSG91_TEMPLATE_LOGIN_OTP_ANDROID=
MSG91_TEMPLATE_BOOKING_CONFIRMED=
MSG91_TEMPLATE_BOOKING_ASSIGNED=
MSG91_TEMPLATE_VENDOR_EN_ROUTE=
MSG91_TEMPLATE_VENDOR_ON_SITE=
MSG91_TEMPLATE_DELIVERY_CODE=
MSG91_TEMPLATE_BOOKING_COMPLETED=
MSG91_TEMPLATE_VENDOR_NEW_JOB=
MSG91_TEMPLATE_VENDOR_JOB_ASSIGNED=
MSG91_TEMPLATE_BOOKING_REMINDER=
MSG91_TEMPLATE_PAYOUT_PAID=
MSG91_TEMPLATE_PAYOUT_FAILED=

# =============================================================================
# Email (SMTP_USER is the From address)
# =============================================================================
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# =============================================================================
# Storage (Cloudflare R2)
# =============================================================================
STORAGE_PROVIDER=r2
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# https://cdn.yourdomain.com or https://pub-xxxx.r2.dev (no trailing slash)
R2_PUBLIC_URL=

# =============================================================================
# Push
# =============================================================================
PUSH_PROVIDER=expo

# =============================================================================
# WhatsApp — MSG91 One API Flow (see docs/message-service.md)
# =============================================================================
# noop = off. msg91 = WhatsApp via Flow API (worker notify.whatsapp queue).
WHATSAPP_PROVIDER=noop

# Flow IDs from MSG91 One API — VAR1, VAR2 order must match docs/message-service.md
MSG91_FLOW_LOGIN_OTP=
MSG91_FLOW_BOOKING_CONFIRMED=
MSG91_FLOW_BOOKING_ASSIGNED=
MSG91_FLOW_VENDOR_EN_ROUTE=
MSG91_FLOW_VENDOR_ON_SITE=
MSG91_FLOW_DELIVERY_CODE=
MSG91_FLOW_BOOKING_COMPLETED=
MSG91_FLOW_VENDOR_NEW_JOB=
MSG91_FLOW_VENDOR_JOB_ASSIGNED=
MSG91_FLOW_BOOKING_REMINDER=
MSG91_FLOW_PAYOUT_PAID=
MSG91_FLOW_PAYOUT_FAILED=

# MSG91_FLOW_API_URL=https://api.msg91.com/api/v5/flow/

# =============================================================================
# Maps (Ola)
# =============================================================================
MAPS_PROVIDER=ola
OLA_MAPS_API_KEY=
OLA_MAPS_CLIENT_ID=
OLA_MAPS_CLIENT_SECRET=

# =============================================================================
# AI / LangSmith (optional — set AI_ENABLED=true + AI_DATABASE_URL if used)
# =============================================================================
LLM_MODEL=
LLM_TOOL_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=
GUARDRAIL_MODEL=

# =============================================================================
# Production checklist (VPS backend/.env)
# =============================================================================
# NODE_ENV=production
# API_PUBLIC_URL=https://api.decorbuddys.com
# WEB_APP_ORIGIN=https://decorbuddys.com
# ADMIN_APP_ORIGIN=https://admin.decorbuddys.com
# SMS_PROVIDER=msg91 · WHATSAPP_PROVIDER=msg91 · fill MSG91_* · pm2 API+worker
# WhatsApp-first: admin WhatsApp on, SMS off until DLT templates approved
# openssl rand -hex 32 for JWT_SECRET and OTP_PEPPER
